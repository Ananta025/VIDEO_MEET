# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (injected at runtime)
.env
.env.*
!.env.example

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test files
coverage
*.test.js
*.spec.js
__tests__

# Temporary files
temp/*
!temp/.gitkeep

# Uploads (mounted as volume in production)
uploads/*
!uploads/.gitkeep

# Documentation
*.md
!README.md

# Docker
Dockerfile*
docker-compose*
.dockerignore
